{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": true,
        ".write": true,
        "telemetry": {
          ".validate": "newData.hasChildren(['deviceOnline']) || newData.hasChildren(['ts']) || newData.hasChildren(['timestamp'])",
          "ts": {
            ".validate": "newData.val() == null || newData.isNumber()"
          },
          "timestamp": {
            ".validate": "newData.val() == null || newData.isNumber()"
          },
          "grossWeightKg": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 120)"
          },
          "grossKg": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 120)"
          },
          "lpgRemainingKg": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "lpgKg": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "gasPercentage": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
          },
          "percent": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
          },
          "gasSensorRaw": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 4096)"
          },
          "gasRaw": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 4096)"
          },
          "gasDigitalState": {
            ".validate": "newData.val() == null || newData.isNumber() || newData.isBoolean()"
          },
          "leakState": {
            ".validate": "newData.val() == null || newData.val() === 'SAFE' || newData.val() === 'WARNING' || newData.val() === 'LEAK_ALARM' || newData.val() === 'SENSOR_FAULT'"
          },
          "gasStatus": {
            ".validate": "newData.val() == null || newData.val() === 'safe' || newData.val() === 'warn' || newData.val() === 'alarm'"
          },
          "gasPpm": {
            ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
          },
          "deviceOnline": {
            ".validate": "newData.val() == null || newData.isBoolean()"
          },
          "sensorFault": {
            ".validate": "newData.val() == null || newData.isBoolean()"
          },
          "source": {
            ".validate": "newData.val() == null || newData.val() === 'live' || newData.val() === 'simulated' || newData.val() === 'stale' || newData.val() === 'offline' || newData.val() === 'fault'"
          }
        },
        "events": {
          "$eventId": {
            ".validate": "newData.hasChildren(['ts', 'type', 'severity'])"
          }
        }
      }
    }
  }
}
