{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (data.child('meta/ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (data.child('meta/ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        "telemetry": {
          ".validate": "newData.hasChildren(['ts', 'grossKg', 'lpgKg', 'percent', 'gasPpm', 'gasStatus', 'source'])",
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "grossKg": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 80"
          },
          "lpgKg": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "percent": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "gasPpm": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "gasStatus": {
            ".validate": "newData.val() === 'safe' || newData.val() === 'warn' || newData.val() === 'alarm'"
          },
          "source": {
            ".validate": "newData.val() === 'live' || newData.val() === 'simulated' || newData.val() === 'stale' || newData.val() === 'offline' || newData.val() === 'fault'"
          }
        },
        "events": {
          "$eventId": {
            ".validate": "newData.hasChildren(['ts', 'type', 'severity'])"
          }
        }
      }
    }
  }
}
