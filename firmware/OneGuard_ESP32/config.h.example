#define DEVICE_AUTH_PASSWORD "YOUR_SECURE_DEVICE_PASSWORD"

// Device Identifier in Realtime Database
#define DEVICE_ID "oneguard_kitchen_01"

// --- Confirmed ESP32 Hardware GPIO Assignments ---
#define HX711_DOUT_PIN 25
#define HX711_SCK_PIN  26

#define MQ6_AO_PIN     34
#define MQ6_DO_PIN     27

#define RTC_SDA_PIN    21
#define RTC_SCL_PIN    22

#define STATUS_LED_PIN 2
// Note: Buzzer is NOT installed. Do not configure a buzzer GPIO. GPIO 27 is dedicated to MQ-6 DO.

// --- MQ-6 Gas Sensor Digital Polarity ---
// Standard LM393 comparator breakout modules pull DO LOW (0) when gas exceeds threshold.
// Set to false only if your specific module has inverted active-HIGH output logic.
#define MQ6_DO_ACTIVE_LOW true

// --- Calibration & Hardware Parameters ---
// Cylinder physical parameters (standard Indian 14.2kg domestic cylinder)
#define DEFAULT_TARE_KG 15.3f
#define DEFAULT_CAPACITY_KG 14.2f

// Calibration factor for HX711 with 4x 50kg half-bridge load cells + Combinator
// Determine using known reference weights (e.g. 5kg, 10kg barbell weight or water)
#define DEFAULT_CALIBRATION_FACTOR -22450.0f

// MQ-6 Load resistance on breakout module (typically 10k or 20k, verify with multimeter)
#define MQ6_RL_VALUE 10.0f 
// Sensor resistance in clean air (determine during 24h clean air burn-in calibration)
#define MQ6_RO_CLEAN_AIR 10.0f 

// Voltage divider ratio between MQ-6 analog output (5V max) and ESP32 GPIO34 (3.3V safe max)
// Using 10k and 10k (or 10k and 20k) divider. Factor = (R1 + R2) / R2
#define MQ6_DIVIDER_RATIO 2.0f

// Safety Alert Thresholds (in approximate sensor response indication)
#define LEAK_WARN_PPM 1000
#define LEAK_ALARM_PPM 2000
#define LEAK_HYSTERESIS_PPM 150

#endif // CONFIG_H
